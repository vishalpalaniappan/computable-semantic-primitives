design("store")
type("primitive")

description("Stores the provided value in a given participant")

narrative_structure {
    # This establishes how this primitive can be used in narratives 
    # Example: store result in total_cost
    {
        syntax: "store {value} in {participant_name}"
    }
}

participants {
    participant(name="value", required="true")
    participant(name="participant_name", required="true")
}

behavior store {
    # Gets the necessary values from the world state
    getFromWorldState(name="value", role="value")
    getFromWorldState(name="store_participant_name", role="store_participant_name")

    # Update the world state
    updateWorldState(
        name=store_participant_name,
        value=value
    )
}

run (store)

invariants {}

generate{
    {
        type: "success",
        sentence: f"Stored {value} in participant named {participant_name}",
    }
}