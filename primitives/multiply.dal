design("multiply")
type("primitive")

description("Multiplies two numbers and stores the results in a participant named result.")

narrative_structure {
    # This establishes how this primitive can be used in narratives 
    # Example: store result of multiply cost_of_bagel and number_of_bagels in total_cost
    {
        syntax: "multiply {multiplicand} and {multiplier}"
    }
}

participants {
    participant(name="multiplicand", required="true")
    participant(name="multiplier", required="true")
}

behavior add {
    # Get the values from the world state
    getFromWorldState(name="multiplicand", role="multiplicand")
    getFromWorldState(name="multiplier", role="multiplier")

    # multiplies the two values and store result in result
    _multiply(result, multiplicand, multiplier)

    # Update the world state
    updateWorldState(
        name="result",
        value=result,
        type="number"
    )
}

run (add)


invariants {
    assert({
        id:1,
        participants: ["multiplicand"],
        condition: multiplicand.type == "number",
        description: "The multiplicand must be a number",
        invalidValues: [
            {
                value: "string_value"
                description: "A string is provided to the multiply primitive as the multiplicand"
            }
        ]
    }),
    assert({
        id:1,
        participants: ["multiplier"],
        condition: multiplier.type == "number",
        description: "The multiplier value must be a number",
        invalidValues: [
            {
                value: "string_value"
                description: "A string is provided to the multiply primitive as the multiplier"
            }
        ]
    })
}

generate{
    {
        type: "success",
        sentence: f"Multiplied {multiplicand} to {multiplier} and the result was {result}.",
    },
    {
        type: "fail_id_1",
        sentence: f"Failed to add the two numbers because multiplicand was not a number.",
    },
    {
        type: "fail_id_2",
        sentence: f"Failed to add the two numbers because multiplier was not a number.",
    }
}