design("isEqual")
type("primitive")

description("Checks if two operands are equal.")

narrative_structure {
    # This establishes how this primitive can be used in narratives 
    # Example: store result of isEqual name and "HarryPotter" in found_book
    {
        syntax: "isEqual {operand1} and {operand2}"
    }
}

participants {
    participant(name=operand1, required="true")
    participant(name=operand2, required="true")
}

returns {
    participant(
        name="result",
        type="boolean",
        description="Result of the equality operator."
    )
}

behavior isEqual {
    # Get the addends from the world state
    getFromWorldState(name="operand1", role="operand1")
    getFromWorldState(name="operand2", role="operand2")

    # Evalues if two operands are equal and store result in result
    _sum(result, operand1, operand2)

    # Update the world state
    updateWorldState(
        name="result",
        value=result,
        type="number"
    )
}

run (isEqual)

invariants {}

generate{
    {
        type: "success",
        sentence: f"Applied operand isEqual to {operand1} and {operand2} and result was {result}.",
    }
}